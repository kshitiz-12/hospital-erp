# Supabase transaction pooler (port 6543) — used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.qiifgcabiwwnviwwnvkk:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma Migrate / db push
# Copy "Direct connection" URI from Supabase → Project Settings → Database
# Host is db.<project-ref>.supabase.co — NOT *.pooler.supabase.com
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.qiifgcabiwwnviwwnvkk.supabase.co:5432/postgres"

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Website system user written into CREATEDBY columns
SYSTEM_USER_ID=1
COMPANY_ID=1
FINANCIAL_YEAR_ID=1

# Razorpay — use test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
